        <mxCell id="MfPzzkA64z0Fu6v8ny2m-92" value="Утечка данных. Риск: критический.&lt;div&gt;Нарушение законодательства, репутационный ущерб,&amp;nbsp;&lt;/div&gt;" style="text;strokeColor=#b85450;fillColor=#f8cecc;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;rounded=1;" vertex="1" parent="MfPzzkA64z0Fu6v8ny2m-91">
